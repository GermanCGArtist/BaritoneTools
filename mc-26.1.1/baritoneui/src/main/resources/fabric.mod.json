{
  "schemaVersion": 1,
  "id": "baritoneui",
  "version": "${version}",
  "name": "BaritoneUI",
  "description": "In-game screen (keybind) to toggle Baritone settings and the LoadChest / SurvivalKit addons.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.baritoneui.BaritoneUiMod"]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.1.1",
    "baritone": "*",
    "java": ">=25"
  },
  "suggests": {
    "loadchest": "*",
    "survivalkit": "*"
  }
}
